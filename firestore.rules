rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function fam(fid) { return get(/databases/$(database)/documents/families/$(fid)).data; }
    function isMember(fid) { let f = fam(fid); return request.auth.uid == f.studentUid || request.auth.uid in f.parentUids; }
    function isParent(fid) { return request.auth.uid in fam(fid).parentUids; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['familyId']);
    }

    match /families/{fid} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.parentUids.size() == 0;

      allow read: if signedIn()
        && (resource.data.studentUid == request.auth.uid || request.auth.uid in resource.data.parentUids);

      allow update: if signedIn() && (
        // parents can change anything except who the student is and the code
        (request.auth.uid in resource.data.parentUids
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentUid', 'code']))
        // the student can change things like their savings goal, but not settings or membership
        || (request.auth.uid == resource.data.studentUid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentUid', 'code', 'settings', 'parentUids', 'parentNames']))
        // a new parent joins by proving they know the family code, adding only themselves
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids', 'parentNames', 'joinCode'])
          && request.resource.data.joinCode == resource.data.code
          && request.resource.data.parentUids.hasAll(resource.data.parentUids)
          && request.resource.data.parentUids.size() == resource.data.parentUids.size() + 1
          && request.auth.uid in request.resource.data.parentUids)
      );

      // Wallet: the app adds earnings automatically; only parents add payouts/bonuses or delete
      match /wallet/{id} {
        allow read: if signedIn() && isMember(fid);
        allow create: if signedIn() && isMember(fid) && (request.resource.data.type == 'earn' || isParent(fid));
        allow update, delete: if signedIn() && isParent(fid);
      }

      match /{sub}/{id} {
        allow read: if signedIn() && isMember(fid);
        allow write: if signedIn() && isMember(fid) && sub != 'wallet';
      }
    }
  }
}
